# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Configurable base URL for the future FastAPI macroeconomic backend.
# Leave empty during frontend development to use the built-in illustrative Indian economic dataset.
VITE_API_BASE_URL=""
