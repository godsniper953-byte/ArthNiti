# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Configurable base URL for the future FastAPI macroeconomic backend.
# Leave empty during frontend development to use the built-in illustrative Indian economic dataset.
VITE_API_BASE_URL=""

# TWELVE_DATA_API_KEY: Optional server-side API key for Twelve Data market quotes.
# Leave empty to use the built-in server-side Yahoo Finance v8 Exchange Feed proxy (/api/market-indices) which requires no API key.
TWELVE_DATA_API_KEY=""

# MARKET_DATA_CACHE_TTL_SECONDS: Server-side cache TTL in seconds for /api/market-indices (default: 15)
# Note: Polling/cache TTL controls how often ArthNiti checks the upstream Yahoo Finance v8 feed; it does not mean the exchange publishes a new tick every 15s (public chart bars use 5-minute intervals with 1-5 min exchange delay).
MARKET_DATA_CACHE_TTL_SECONDS="15"

# MARKET_OPEN_POLL_INTERVAL_SECONDS: Recommended client poll interval in seconds during NSE/BSE open & pre-open sessions (default: 30)
MARKET_OPEN_POLL_INTERVAL_SECONDS="30"

# MARKET_CLOSED_POLL_INTERVAL_SECONDS: Recommended client poll interval in seconds when NSE/BSE markets are closed (default: 300)
MARKET_CLOSED_POLL_INTERVAL_SECONDS="300"

# VITE_MARKET_OPEN_POLL_INTERVAL_MS: Frontend polling interval in milliseconds when Indian markets are OPEN/PRE_OPEN (default: 30000)
VITE_MARKET_OPEN_POLL_INTERVAL_MS="30000"

# VITE_MARKET_CLOSED_POLL_INTERVAL_MS: Frontend polling interval in milliseconds when Indian markets are CLOSED (default: 300000)
VITE_MARKET_CLOSED_POLL_INTERVAL_MS="300000"

# VITE_ECONOMIC_NEWS_POLL_INTERVAL_MS: Frontend polling interval in milliseconds for /api/economic-news (default: 300000)
VITE_ECONOMIC_NEWS_POLL_INTERVAL_MS="300000"

# ECONOMIST_BITES_CACHE_TTL_SECONDS: Server-side cache TTL in seconds for /api/economist-bites (default: 300)
ECONOMIST_BITES_CACHE_TTL_SECONDS="300"

# ECONOMIST_BITES_INGEST_SECRET: Optional Bearer token secret to authenticate POST /api/economist-bites manual/cron ingestion triggers
ECONOMIST_BITES_INGEST_SECRET=""

# VITE_ECONOMIST_BITES_POLL_INTERVAL_MS: Frontend polling interval in milliseconds for /api/economist-bites (default: 300000)
VITE_ECONOMIST_BITES_POLL_INTERVAL_MS="300000"

# ============================================================================
# SECURITY, CLOUDFLARE TURNSTILE CAPTCHA & DISTRIBUTED RATE LIMITING
# ============================================================================

# Cloudflare Turnstile Site Key (Public — safe for frontend widget; both NEXT_PUBLIC_ and VITE_ prefixes are supported)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# Cloudflare Turnstile Secret Key (Server-side ONLY — NEVER expose in frontend code)
TURNSTILE_SECRET_KEY=""

# Optional Distributed Rate-Limit Store (Upstash Redis REST API or Vercel KV REST API)
# Leave empty in local development to use the built-in server-side sliding-window store.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Configurable Per-Endpoint API Rate Limits (requests per minute per IP)
RATE_LIMIT_MARKET_INDICES_PER_MIN="60"
RATE_LIMIT_ECONOMIC_NEWS_PER_MIN="30"
RATE_LIMIT_ECONOMIST_BITES_PER_MIN="30"
RATE_LIMIT_SENSITIVE_AI_PER_MIN="10"
RATE_LIMIT_HEALTH_PER_MIN="10"

# Optional Bearer tokens for authorized health checks and protected /api/security-monitor telemetry
HEALTH_MONITOR_TOKEN=""
SECURITY_MONITOR_TOKEN=""

# Server-side HMAC secret and configurable TTL (in seconds) for first-visit human verification session tokens
SECURITY_CLEARANCE_SECRET=""
HUMAN_VERIFICATION_SESSION_TTL_SECONDS="900"
