# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Configurable base URL for the future FastAPI macroeconomic backend.
# Leave empty during frontend development to use the built-in illustrative Indian economic dataset.
VITE_API_BASE_URL=""

# TWELVE_DATA_API_KEY: Optional server-side API key for Twelve Data market quotes.
# Leave empty to use the built-in server-side Yahoo Finance v8 Exchange Feed proxy (/api/market-indices) which requires no API key.
TWELVE_DATA_API_KEY=""

# MARKET_DATA_CACHE_TTL_SECONDS: Server-side cache TTL in seconds for /api/market-indices (default: 15)
MARKET_DATA_CACHE_TTL_SECONDS="15"

